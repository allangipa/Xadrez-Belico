# Xadrez Bélico — servidor (Hostinger, LiteSpeed)
ErrorDocument 404 /404.html

# raiz sem /index.html
DirectoryIndex index.html

# Domínio principal: xadrezbelico.com, sem www (desde 03/10/2026). O .com.br e o
# www.xadrezbelico.com servem os mesmos arquivos e redirecionam 301, caminho a
# caminho e com a query string, para https://xadrezbelico.com. Só os hosts
# listados: o domínio temporário da Hostinger e o resto ficam como estão.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP_HOST} ^(www\.)?xadrezbelico\.com\.br\.?(:\d+)?$ [NC,OR]
  RewriteCond %{HTTP_HOST} ^www\.xadrezbelico\.com\.?(:\d+)?$ [NC]
  RewriteRule ^ https://xadrezbelico.com%{REQUEST_URI} [R=301,L,NE]
  # http -> https no domínio principal (a Hostinger também força; aqui vai num salto só)
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP_HOST} ^xadrezbelico\.com\.?(:\d+)?$ [NC]
  RewriteRule ^ https://xadrezbelico.com%{REQUEST_URI} [R=301,L,NE]
</IfModule>

# o código-fonte vai no repositório, mas não é servido
RedirectMatch 404 ^/(_src|\.claude|\.git)(/|$)
# com o deploy por Git o repositório inteiro vai para public_html:
# README e .gitignore são notas de trabalho, não página
RedirectMatch 404 ^/(README\.md|\.gitignore)$

AddType image/webp .webp

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 10 minutes"
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>
